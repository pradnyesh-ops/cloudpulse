# ─── CloudPulse Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Values shown here are safe defaults for local / demo mode.

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
# AWS_PROFILE=default          # uncomment if using named profiles

# ── Kinesis ───────────────────────────────────────────────────────────────────
KINESIS_STREAM_NAME=cloudpulse-stream
KINESIS_SHARD_COUNT=2

# ── S3 ────────────────────────────────────────────────────────────────────────
S3_BUCKET=cloudpulse-data-bucket   # must be globally unique; change before deploying

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_DEBUG=true
SECRET_KEY=change-me-to-a-random-string

# ── Demo / Simulation ─────────────────────────────────────────────────────────
# Set DEMO_MODE=false to use real AWS services
DEMO_MODE=true
PROBE_COUNT=50
INGESTION_RATE=5.0     # records per second generated by the producer
LOCAL_DATA_DIR=data    # directory for demo-mode JSON state files

# ── Real streaming data source (Wikimedia Event Streams, no key required) ──────
# Set USE_REAL_STREAM=true to consume live Wikipedia edit events instead of
# simulated probe data.  The Wikimedia SSE stream is free and public:
#   https://stream.wikimedia.org/v2/stream/recentchange
USE_REAL_STREAM=false

# ── Optional: RIPE Atlas public API (no key required) ─────────────────────────
USE_RIPE_ATLAS=false
